{
  "name": "erschliessung-app",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -n SERVER,WEB -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "app": "npm run build && electron .",
    "app:nobuild": "electron .",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "dist:win": "npm run build && npm run rebuild:electron && electron-builder --win"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "docx": "^9.0.2",
    "express": "^4.21.0",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^44.4.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.erschliessung.app",
    "productName": "Erschließung",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "src/lib/**/*",
      "shared/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.test.js"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/@napi-rs/**/*",
      "server/tessdata/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
